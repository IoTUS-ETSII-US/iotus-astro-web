---
const features = [
  {
    tag: 'GRET-01',
    title: 'GRET-Tech & Gadgets',
    desc: 'Análisis sin filtro del hardware más brutal. Desarmamos y testeamos tecnología al límite.',
    bg: 'bg-yellow-300',
  },
  {
    tag: 'IOT-02',
    title: 'Sistemas IOTUS',
    desc: 'Automatización y sensores en tiempo real. Redes distribuidas con monitoreo de estado live.',
    bg: 'bg-pink-400',
  },
  {
    tag: 'DEV-03',
    title: 'Open Source',
    desc: 'Software libre, herramientas de terminal y experimentos sin código propietario ni sorpresas.',
    bg: 'bg-lime-300',
  },
]
---

<section
  id="explorar"
  class="border-b-4 border-black bg-white px-4 py-16 sm:px-6 lg:px-8"
>
  <div class="mx-auto max-w-7xl">
    <div
      class="mb-12 inline-block border-4 border-black bg-pink-400 p-4 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
    >
      <h2 class="text-3xl font-black uppercase sm:text-4xl">
        CATEGORÍAS DESTACADAS
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {
        features.map((item) => (
          <article
            class={`border-4 border-black ${item.bg} p-6 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-transform hover:-translate-y-1`}
          >
            <div class="mb-4 inline-block border-2 border-black bg-white px-2 py-1 text-xs font-black uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
              {item.tag}
            </div>
            <h3 class="mb-3 text-2xl font-black text-black uppercase">
              {item.title}
            </h3>
            <p class="border-t-2 border-black pt-3 text-sm leading-relaxed font-bold text-black">
              {item.desc}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
