---

---

<section class="bg-yellow-300 px-4 py-16 sm:px-6 lg:px-8">
  <div
    class="mx-auto max-w-4xl border-4 border-black bg-white p-8 shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] md:p-12"
  >
    <div class="text-center">
      <span
        class="inline-block border-2 border-black bg-cyan-400 px-3 py-1 text-xs font-black uppercase shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]"
      >
        BOLETÍN SEMANAL
      </span>
      <h2 class="mt-4 text-3xl font-black uppercase sm:text-5xl">
        NO TE PIERDAS NADA
      </h2>
      <p class="mt-2 text-sm font-bold sm:text-base">
        Suscríbete para recibir los mejores análisis de gadgets y novedades tech
        directamente en tu inbox.
      </p>

      <form class="mt-8 flex flex-col gap-4 sm:flex-row sm:justify-center">
        <input
          type="email"
          placeholder="TU-EMAIL@DOMINIO.COM"
          class="w-full border-4 border-black bg-slate-100 px-4 py-3 font-bold text-black placeholder-slate-500 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] focus:bg-white focus:outline-none sm:max-w-xs"
          required
        />
        <button
          type="submit"
          class="border-4 border-black bg-cyan-400 px-6 py-3 text-base font-black text-black uppercase shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:bg-pink-400 hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-1 active:translate-y-1 active:shadow-none"
        >
          UNIRME AHORA
        </button>
      </form>
    </div>
  </div>
</section>
