---
import '@/styles/global.css'
import Header from '@/components/header/Header.astro'
import Footer from '@/components/footer/Footer.astro'
import type { Project } from '@/types/Project.interface'
import ProjectsSEO from '@/components/seo/ProjectsSEO.astro'
import TwitterSEO from '@/components/seo/TwitterSEO.astro'
import OpenGraphSEO from '@/components/seo/OpenGraphSEO.astro'

interface Props {
  title: string
  description: string
  canonical?: string
  image?: string
  type?: 'website' | 'article'
  schema?: 'project' | 'news' | null
  project?: Project
  noindex?: boolean
}

const {
  title,
  description,
  canonical = Astro.url.href.replace(/\/$/, ''),
  image = new URL('/images/logo-image.avif', Astro.site).href,
  type = 'website',
  schema = null,
  noindex = false,
  project = null,
} = Astro.props

const siteName = 'iotus etsii'
const formattedTitle = title === siteName ? title : `${title} | ${siteName}`
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{formattedTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Control de indexación dinámico -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow" />}

    <meta
      name="google-site-verification"
      content="U3RAZUrqOIdclYnOr52XrECPr178YH9NyJcDnouQrHg"
    />

    <OpenGraphSEO
      data={{
        siteName,
        type,
        canonical,
        formattedTitle,
        description,
        image,
        title,
      }}
    />
    <TwitterSEO data={{ canonical, formattedTitle, description, image }} />

    {
      schema === 'project' && project && (
        <ProjectsSEO
          projectName={project.data.title}
          launchDate={project.data.pubDate}
          summary={project.data.description}
          techStack={project.data.tags}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 font-mono">
    <Header />
    <main class="flex flex-1 flex-col">
      <slot />
    </main>
    <Footer />
  </body>
</html>
