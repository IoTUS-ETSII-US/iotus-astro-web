---
import SEOLayout from '@/layouts/SEOLayout.astro'

// Componentes
import MainSection from '@/components/home/MainSection.astro'
import CategoriesSection from '@/components/home/CategoriesSection.astro'
import MailingSection from '@/components/home/MailingSection.astro'

// Datos
import { name } from '@/data/info.json'

const title = `Home - ${name}`
---

<SEOLayout title={title} description="Página principal IOTUS">
  <div class="w-full bg-cyan-400 font-mono text-black">
    <MainSection />
    <CategoriesSection />
    <!-- <MailingSection /> -->
  </div>
</SEOLayout>
