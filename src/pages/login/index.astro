---
import Layout from '@/layouts/Layout.astro'
import { name } from '@/data/info.json'
import LoginForm from '@/components/auth/LoginForm'

const title = `Iniciar Sesión - ${name}`
---

<Layout title={title}>
  <div
    class="flex w-full flex-1 items-center justify-center bg-cyan-400 px-4 py-12 font-mono text-black"
  >
    <div
      class="w-full max-w-md border-4 border-black bg-white p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]"
    >
      <!-- Banner -->
      <div class="mb-6 border-b-4 border-black pb-4 text-center">
        <span
          class="inline-block border-2 border-black bg-yellow-300 px-3 py-1 text-xs font-black uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
        >
          ACCESO IOTUS
        </span>
        <h1 class="mt-2 text-3xl font-black uppercase">INICIAR SESIÓN</h1>
      </div>

      <!-- Formulario -->
      <LoginForm client:only="react"/>

      <!-- Redirección a Registro -->
      <div class="mt-6 border-t-4 border-black pt-6 text-center">
        <p class="mb-3 text-xs font-bold uppercase">
          ¿Aún no tienes una cuenta?
        </p>
        <a
          href="/register"
          class="inline-block w-full border-4 border-black bg-lime-300 py-2.5 text-center text-xs font-black uppercase shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all hover:bg-yellow-300 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
        >
          REGISTRARSE AQUÍ ➔
        </a>
      </div>
    </div>
  </div>
</Layout>
